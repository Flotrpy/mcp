#!/bin/sh
# Fake adb for handset's end-to-end tests. Logs every call to $HANDSET_LOG and
# serves the screen in $HANDSET_SCREEN (switching to $HANDSET_NEXT_SCREEN
# after the first tap, to simulate navigation).
echo "adb $*" >> "${HANDSET_LOG:-/dev/null}"
case "$*" in
  "devices -l")
    printf 'List of devices attached\nemulator-5554          device product:sdk_gphone64 model:Pixel_8 device:emu64a\n\n' ;;
  *"uiautomator dump"*)
    if [ -n "$HANDSET_NEXT_SCREEN" ] && grep -q "input tap" "${HANDSET_LOG:-/dev/null}" 2>/dev/null; then
      cat "$HANDSET_NEXT_SCREEN"
    else
      cat "$HANDSET_SCREEN"
    fi
    echo "UI hierchary dumped to: /dev/tty" ;;
  *) ;;
esac
